func (f *File) Restore(key string) bool {
	for i := len(f.entries) - 1; i >= 0; i-- {
		e := f.entries[i]
		if e.Kind != KindDisabledPair || e.Key != key {
			continue
		}
		for j, line := range e.Raw {
			e.Raw[j] = strings.Replace(line, e.commentPrefix, "", 1)
		}
		e.Kind = KindPair
		e.commentPrefix = ""
		return true
	}
	return false
}